{
  "info": {
    "_postman_id": "b6e2a8b0-6b2a-4f7a-9e2a-tienda-negocios-api",
    "name": "Tienda de Negocios — API REST (Entrega 3)",
    "description": "Productos, Categorías, Carrito y Checkout. Todas las respuestas son JSON con el formato { success, data|errors, message }.\n\nEl carrito se identifica con el header X-Cart-Token: la primera petición a cualquier endpoint de /carrito o /checkout no necesita mandarlo (se crea un carrito nuevo), y la respuesta lo devuelve en ese mismo header. Los scripts de test de esta colección lo guardan solo automáticamente en la variable {{cart_token}} para las peticiones siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "cart_token",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": "1"
    },
    {
      "key": "categoria_id",
      "value": "1"
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "pedido_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/productos?por_pagina=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "por_pagina",
                  "value": "10"
                },
                {
                  "key": "categoria_id",
                  "value": "1",
                  "disabled": true
                }
              ]
            },
            "description": "Listado paginado. Filtro opcional por categoria_id (bonus: búsqueda por categoría)."
          }
        },
        {
          "name": "Ver un producto",
          "request": {
            "method": "GET",
