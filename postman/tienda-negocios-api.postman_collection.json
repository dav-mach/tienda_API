    {
      "name": "Carrito",
      "item": [
        {
          "name": "Ver carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.headers.get('X-Cart-Token');",
                  "if (token) { pm.collectionVariables.set('cart_token', token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Cart-Token",
                "value": "{{cart_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/carrito",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito"
              ]
            },
            "description": "Primera vez: no hace falta mandar X-Cart-Token, se crea un carrito nuevo y el test script de esta request lo guarda solo en {{cart_token}}."
          }
        },
        {
          "name": "Agregar producto al carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.headers.get('X-Cart-Token');",
                  "if (token) { pm.collectionVariables.set('cart_token', token); }",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('item_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Cart-Token",
                "value": "{{cart_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": {{producto_id}},\n  \"cantidad\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/carrito/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito",
                "items"
              ]
            }
          }
        },
        {
          "name": "Actualizar cantidad de un item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Cart-Token",
                "value": "{{cart_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/carrito/items/{{item_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito",
                "items",
                "{{item_id}}"
              ]
            }
          }
        },
        {
          "name": "Resumen de compra",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Cart-Token",
                "value": "{{cart_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/carrito/resumen",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito",
                "resumen"
              ]
            },
            "description": "Devuelve cantidad_items, subtotal, impuestos, costo_envio y total."
          }
        },
        {
          "name": "Eliminar un producto del carrito",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
