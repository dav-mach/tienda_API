                "value": "{{cart_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/carrito/items/{{item_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito",
                "items",
                "{{item_id}}"
              ]
            }
          }
        },
        {
          "name": "Vaciar carrito",
