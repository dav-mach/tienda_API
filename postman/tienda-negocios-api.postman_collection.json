    {
      "name": "Checkout",
      "item": [
        {
          "name": "1. Registrar datos de envío/pago",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('pedido_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Cart-Token",
                "value": "{{cart_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_cliente\": \"Ana Pérez\",\n  \"email\": \"ana.perez@mail.com\",\n  \"direccion_envio\": \"Av. Siempre Viva 742\",\n  \"ciudad\": \"General Pico\",\n  \"codigo_postal\": \"6360\",\n  \"metodo_pago\": \"tarjeta\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "description": "Crea el Pedido en estado pendiente_confirmacion con una foto del carrito actual. Todavía no descuenta stock."
          }
        },
        {
          "name": "2. Confirmar compra",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/checkout/{{pedido_id}}/confirmar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "checkout",
                "{{pedido_id}}",
                "confirmar"
              ]
            },
            "description": "Revalida stock, lo descuenta, marca el pedido como confirmado y vacía el carrito."
          }
        },
        {
          "name": "Ver estado de un pedido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/checkout/{{pedido_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "checkout",
                "{{pedido_id}}"
              ]
            }
          }
        }
      ]
    },
