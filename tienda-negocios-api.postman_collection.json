    "_postman_id": "b6e2a8b0-6b2a-4f7a-9e2a-tienda-negocios-api",
    "name": "Tienda de Negocios — API REST (Entrega 4: JWT)",
    "description": "API REST con autenticación JWT. Flujo: registrarse o loguearse en la carpeta \"Autenticación\" para obtener un token; el script de esas requests guarda el token automáticamente en la variable {{jwt_token}}. Las carpetas Carrito y Checkout (y las operaciones de escritura de Productos/Categorías) mandan ese token en el header Authorization: Bearer {{jwt_token}} y responden 401 si falta o es inválido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": "1"
    },
    {
      "key": "categoria_id",
      "value": "1"
    },
    {
      "key": "item_id",
      "value": ""
    },
