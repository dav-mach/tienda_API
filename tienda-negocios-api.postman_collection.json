    {
      "name": "Seguridad (acceso denegado vs permitido)",
      "item": [
        {
          "name": "Ver carrito SIN token -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/carrito",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito"
              ]
            },
            "description": "Sin header Authorization. Debe responder 401 (acceso denegado)."
          }
        },
        {
          "name": "Ver carrito CON token -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/carrito",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito"
              ]
            },
            "description": "Con el token válido guardado en {{jwt_token}}. Debe responder 200."
          }
        },
        {
          "name": "Token inválido -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer token.invalido.123"
              }
            ],
            "url": {
              "raw": "{{base_url}}/carrito",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carrito"
              ]
            },
            "description": "Token con formato roto. Debe responder 401 con \"El token no es válido\"."
          }
        },
        {
          "name": "Crear producto SIN token -> 401",
          "request": {
            "method": "POST",
            "header": [
